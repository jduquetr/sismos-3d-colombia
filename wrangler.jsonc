{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sismos-3d-colombia",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-26",
  // api/guardar-evento.js usa crypto, Buffer y process.env de Node.
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node tools/preparar-dist.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Mismas URLs que en Vercel: sin quitar .html ni redirigir.
    "html_handling": "none"
  },
  "routes": [
    { "pattern": "seismic-explorer.jduquetr.com", "custom_domain": true }
  ]
}
